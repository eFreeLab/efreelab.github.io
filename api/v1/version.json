---
layout: none
sitemap: false
---
{%- comment -%}
  取所有 type=release 的文章中最靠后（日期最新）的一篇作为当前发行版。
  Jekyll 无法直接比较版本号大小，因此按日期排序 —— 发布新版本时把 date 写最新即可。
  App 端自行解析版本号字符串比较（Kotlin 三行代码），故此处只输出字符串。
{%- endcomment -%}
{%- assign releases = site.posts | where_exp: "p", "p.xscan.app == 'xuanscan'" | where_exp: "p", "p.xscan.type == 'release'" | sort: "date" | reverse -%}
{%- assign rel = releases | first -%}
{
  "v": 1,
  "app": "xuanscan",
  "generated": {{ site.time | date_to_xmlschema | jsonify }},
  "latest": {
    "name": {% if rel %}{{ rel.xscan.version | default: "0.0.0" | jsonify }}{% else %}"0.0.0"{% endif %},
    "date": {% if rel %}{{ rel.date | date_to_xmlschema | jsonify }}{% else %}""{% endif %},
    "changelog": {% if rel %}{{ rel.url | absolute_url | jsonify }}{% else %}""{% endif %}
  },
  "minSupported": {% if rel and rel.xscan.minSupported %}{{ rel.xscan.minSupported | jsonify }}{% else %}"0.0.0"{% endif %},
  "channels": [
{%- if rel and rel.xscan.channels -%}
{%- for c in rel.xscan.channels %}
    {
      "name": {{ c.name | jsonify }},
      "url": {{ c.url | jsonify }},
      "note": {{ c.note | default: "" | jsonify }}
    }{% unless forloop.last %},{% endunless %}
{%- endfor %}
{%- endif %}
  ]
}
