{
  "v": 1,
  "app": "xuanscan",
  "_comment": "App 自查自检规则。云端可热更新——发现某机型/系统有问题，改这个 JSON 就能让所有客户端提示规避方案，无需发版。",
  "updated": "2026-09-13T00:00:00Z",
  "metrics": {
    "_comment": "App 负责采集下列指标，供下方 rules 判定",
    "list": [
      { "key": "storage_free_mb", "desc": "可用存储空间(MB)" },
      { "key": "memory_avail_mb", "desc": "可用内存(MB)" },
      { "key": "perm_camera", "desc": "相机权限" },
      { "key": "perm_storage", "desc": "相册读取权限" },
      { "key": "model_ocr_present", "desc": "OCR 模型完整" },
      { "key": "model_matte_present", "desc": "抠图模型完整（用到才检查）" },
      { "key": "signature_valid", "desc": "安装包签名校验通过" },
      { "key": "network_reachable", "desc": "能连到官方站点" },
      { "key": "version_code", "desc": "当前版本号(整数)" },
      { "key": "device_model", "desc": "机型" },
      { "key": "android_api", "desc": "Android API 级别" },
      { "key": "db_ok", "desc": "数据库完整性" },
      { "key": "crash_pending", "desc": "有未发送的崩溃日志" }
    ]
  },
  "rules": [
    {
      "id": "sig_tampered",
      "level": "critical",
      "title": "安装包可能已被篡改",
      "desc": "签名校验未通过。请从官方渠道重新下载安装，以免个人信息泄露。",
      "when": { "metric": "signature_valid", "op": "==", "value": false },
      "fix": { "type": "open_url", "label": "去官方下载", "url": "https://efreelab.github.io/xuanscan/" },
      "block": true
    },
    {
      "id": "storage_low",
      "level": "warn",
      "title": "存储空间不足",
      "desc": "当前可用 {storage_free_mb}MB，建议保留 500MB 以上，否则扫描件导出可能失败。",
      "when": { "metric": "storage_free_mb", "op": "<", "value": 500 },
      "fix": { "type": "open_system", "label": "去清理", "action": "android.settings.INTERNAL_STORAGE_SETTINGS" }
    },
    {
      "id": "model_ocr_missing",
      "level": "error",
      "title": "OCR 模型缺失",
      "desc": "文字识别模型不完整（可能被清理工具删除）。重新下载约 14MB。",
      "when": { "metric": "model_ocr_present", "op": "==", "value": false },
      "fix": { "type": "download_model", "label": "重新下载", "key": "ocr" }
    },
    {
      "id": "perm_camera_denied",
      "level": "error",
      "title": "相机权限未授予",
      "desc": "没有相机权限将无法扫描。可在系统设置中重新开启。",
      "when": { "metric": "perm_camera", "op": "==", "value": false },
      "fix": { "type": "request_permission", "label": "去开启", "permission": "android.permission.CAMERA" }
    },
    {
      "id": "crash_pending",
      "level": "info",
      "title": "有未发送的崩溃日志",
      "desc": "上次崩溃的日志还在本地。发送给我们可以帮助修复问题（仅含技术信息，不含你的文件）。",
      "when": { "metric": "crash_pending", "op": "==", "value": true },
      "fix": { "type": "send_report", "label": "一键发送" }
    },
    {
      "id": "network_unreachable",
      "level": "info",
      "title": "暂时连不上官方站点",
      "desc": "不影响本地扫描与识别；但版本更新、公告与 AI 功能需要联网。可稍后重试。",
      "when": { "metric": "network_reachable", "op": "==", "value": false },
      "fix": { "type": "retry", "label": "重试" }
    },
    {
      "id": "known_bad_device_placeholder",
      "level": "info",
      "title": "已知兼容性提示",
      "desc": "检测到 {device_model} 上相册导入可能异常，建议改用相机直接拍摄。",
      "when": { "metric": "device_model", "op": "in", "value": [] },
      "fix": { "type": "none" },
      "_note": "value 为空数组 = 规则不生效。发现问题时在此填入机型即可，无需发版。"
    },
    {
      "id": "android_too_old",
      "level": "warn",
      "title": "系统版本过低",
      "desc": "当前 Android API {android_api}，低于推荐值。部分功能可能不稳定。",
      "when": { "metric": "android_api", "op": "<", "value": 26 },
      "fix": { "type": "none" }
    },
    {
      "id": "db_corrupt",
      "level": "error",
      "title": "本地数据库异常",
      "desc": "文件索引可能损坏。可尝试修复；修复失败将重建索引（历史记录可能丢失，但图片文件不受影响）。",
      "when": { "metric": "db_ok", "op": "==", "value": false },
      "fix": { "type": "repair_db", "label": "尝试修复" }
    }
  ]
}
